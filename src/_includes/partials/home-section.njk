{% if collections.editorialGuides and collections.editorialGuides.length %}
<section class="container section-block editorial-guides-home">
  <div class="section-heading section-heading-row"><div><span class="eyebrow">ESPECIAIS DO GUIA</span><h2>Guias, rankings e comparativos</h2><p>Listas práticas e comparações editoriais para decidir com mais confiança.</p></div><a href="/guias/" class="text-link">Ver todos os artigos ↗</a></div>
  <div class="editorial-home-grid">
    {% for guide in collections.editorialGuides %}
      <a class="editorial-home-card" href="{{ guide.url }}"><span class="eyebrow">{% if guide.data.editorial_type == 'comparativo' %}COMPARATIVO{% else %}GUIA DE COMPRA{% endif %}</span><h3>{{ guide.data.title }}</h3>{% if guide.data.description %}<p>{{ guide.data.description | striptags | truncate(145) }}</p>{% endif %}<span class="text-link">Ler artigo ↗</span></a>
    {% endfor %}
  </div>
</section>
{% endif %}
