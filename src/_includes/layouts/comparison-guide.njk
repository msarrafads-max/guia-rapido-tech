---
layout: layouts/base.njk
---
<article class="editorial-page container comparison-guide comparison-guide-page">
  <nav class="breadcrumbs" aria-label="Você está aqui"><a href="/">Início</a><span>›</span><a href="/guias/">Guias e comparativos</a><span>›</span><span>{{ title }}</span></nav>
  <header class="editorial-hero comparison-guide-hero">
    <span class="eyebrow">{{ editorial_label or "COMPARATIVO ESPECIAL" }}</span>
    <h1>{{ title }}</h1>
    {% if description %}<p class="editorial-lead">{{ description }}</p>{% endif %}
    {% if author or reading_time or date %}<div class="comparison-guide-meta">{% if author %}<span>Por {{ author }}</span>{% endif %}{% if date %}<span>{{ date | dateBR }}</span>{% endif %}{% if reading_time %}<span>{{ reading_time }} de leitura</span>{% endif %}</div>{% endif %}
    {% if cover_image %}<figure class="comparison-guide-cover"><img src="{{ cover_image }}" alt="{{ cover_alt or title }}" fetchpriority="high">{% if cover_caption %}<figcaption>{{ cover_caption }}</figcaption>{% endif %}</figure>{% endif %}
    {% if intro %}<div class="prose editorial-intro">{{ intro | markdown | safe }}</div>{% endif %}
  </header>

  {% if products and products.length %}
  <section class="comparison-guide-products" aria-label="Produtos comparados">
    {% for product in products %}
    <article class="comparison-guide-product">
      <div class="comparison-guide-product-heading"><span class="editorial-rank">{{ product.rank or ('OPÇÃO ' + loop.index) }}</span><h2>{{ product.name }}</h2></div>
      <div class="comparison-guide-layout">
        <div class="comparison-guide-image">{% if product.image %}<img src="{{ product.image }}" alt="{{ product.image_alt or product.name }}" loading="lazy">{% else %}<div class="image-placeholder"><span>Imagem do produto</span></div>{% endif %}</div>
        <div class="comparison-guide-copy">{% if product.description %}<p>{{ product.description }}</p>{% endif %}{% if product.review_slug %}<a class="button button-small" href="/{{ product.category or 'smartphones' }}/{{ product.review_slug }}.html">{{ product.button_text or 'Ver análise completa' }} ↗</a>{% elif product.review_url %}<a class="button button-small" href="{{ product.review_url }}">{{ product.button_text or 'Ver análise completa' }} ↗</a>{% endif %}</div>
      </div>
      {% if product.strengths and product.strengths.length %}<div class="strengths-table-wrap"><h3 class="comparison-guide-strengths-title">Principais pontos fortes</h3><ul class="comparison-guide-strengths">{% for strength in product.strengths %}{% if loop.index <= 3 and strength %}<li>{{ strength }}</li>{% endif %}{% endfor %}</ul></div>{% endif %}
    </article>
    {% endfor %}
  </section>
  {% endif %}

  {% if body %}<section class="article-body prose comparison-guide-body">{{ body | markdown | safe }}</section>{% endif %}
  <footer class="editorial-footer"><a class="text-link" href="/guias/">← Ver outros guias e comparativos</a></footer>
</article>
