<!doctype html>
<html lang="pt-BR" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title or site.seo_title or site.site_name }}</title>
  <meta name="description" content="{{ description or site.seo_description or site.description }}">
  {% if seo_keywords %}<meta name="keywords" content="{{ seo_keywords }}">{% endif %}
  <meta name="color-scheme" content="light dark">
  <meta property="og:site_name" content="{{ site.site_name }}">
  <meta property="og:title" content="{{ seo_title or title or site.site_name }}">
  <meta property="og:description" content="{{ seo_description or description or site.description }}">
  {% if image %}<meta property="og:image" content="{{ image | absoluteUrl('https://guiarapidotech.com.br') }}">{% endif %}
  {% if canonical %}<link rel="canonical" href="{{ canonical }}">{% endif %}
  <link rel="icon" href="/assets/images/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/assets/css/site.css">
  <link rel="stylesheet" href="/assets/css/review-enhancements.css">
  <script>
    (function(){try{var t=localStorage.getItem('grt-theme');if(t==='dark'||t==='light')document.documentElement.dataset.theme=t;}catch(e){}})();
  </script>
</head>
<body style="--brand: {{ site.primary_color or '#2563eb' }}; --accent: {{ site.accent_color or '#12b981' }}; --light-bg: {{ site.light_background or '#f5f7fb' }}; --light-text: {{ site.light_text or '#172033' }}; --dark-bg: {{ site.dark_background or '#0b1020' }}; --dark-text: {{ site.dark_text or '#edf2ff' }};">
  {% include "partials/header.njk" %}
  <main id="main-content">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
  <div class="cookie-notice" id="cookie-notice" role="region" aria-label="Aviso de cookies" hidden>
    <p>Usamos armazenamento local para lembrar suas preferências de tema e este aviso. <a href="/privacidade.html">Saiba mais na Política de Privacidade</a>.</p>
    <button type="button" class="cookie-accept" id="cookie-accept">Entendi</button>
  </div>
  {% include "partials/article-index.njk" %}
  <script src="/assets/js/site.js" defer></script>
</body>
</html>
