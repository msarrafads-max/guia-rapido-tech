---
layout: layouts/base.njk
---
<article class="review-page container">
  <nav class="breadcrumbs" aria-label="Você está aqui"><a href="/">Início</a><span>›</span><a href="/{{ category }}/">{{ category | title }}</a><span>›</span><span>{{ title }}</span></nav>

  <header class="review-heading">
    <span class="eyebrow">{{ badge or "ANÁLISE" }}{% if brand %} · {{ brand }}{% endif %}</span>
    <h1>{{ title }}</h1>
    {% if seo_description %}<p class="review-deck">{{ seo_description }}</p>{% endif %}
    <p class="published-date">Publicado em <time datetime="{{ date | dateISO }}">{{ date | dateBR }}</time>{% if updated %} · Atualizado em <time datetime="{{ updated | dateISO }}">{{ updated | dateBR }}</time>{% endif %}</p>
  </header>

  <section class="product-overview">
    <div class="product-photo">
      {% if image %}<img src="{{ image }}" alt="{{ image_alt or title }}">{% else %}<div class="image-placeholder large"><span>Imagem do produto</span></div>{% endif %}
      {% if estimated_price %}<p class="estimated-price">Preço estimado: <strong>{{ estimated_price }}</strong></p>{% endif %}
    </div>
    <div class="offers-panel">
      <h2>Onde encontrar</h2>
      {% set store_names = ["Amazon", "Mercado Livre", "Shopee"] %}
      {% set store_keys = ["amazon", "mercadolivre", "shopee"] %}
      {% for key in store_keys %}
        {% set offer = offers[key] %}
        <div class="offer-card">
          <div><strong>{{ store_names[loop.index0] }}</strong>
            {% if offer and offer.availability == "available" and offer.price %}<span class="offer-price">{{ offer.price }}</span>{% endif %}
            <p>{% if not offer or offer.availability == "unknown" %}Disponibilidade não verificada{% elif offer.availability == "unavailable" %}Produto indisponível{% else %}{{ offer.detail or "Consulte preço, frete e condições na loja." }}{% endif %}</p>
          </div>
          {% if offer and offer.availability == "available" and offer.url %}<a class="button button-small" href="{{ offer.url }}" target="_blank" rel="sponsored nofollow noopener">Ver oferta ↗</a>{% else %}<span class="availability-pill">{% if offer and offer.availability == "unavailable" %}Indisponível{% else %}Consultar{% endif %}</span>{% endif %}
        </div>
      {% endfor %}
      <p class="affiliate-note">Os preços e a disponibilidade podem mudar. Confira as condições no site da loja.</p>
    </div>
  </section>

  {% if summary_analysis %}
  <section class="summary-analysis">
    <span class="eyebrow">RESUMO DA ANÁLISE</span>
    <h2>O que achamos do {{ model or title }}</h2>
    <p>{{ summary_analysis }}</p>
  </section>
  {% endif %}

  {% if specs %}
  <section class="spec-section">
    <div class="section-heading"><div><span class="eyebrow">FICHA TÉCNICA</span><h2>Principais características</h2></div></div>
    <div class="spec-grid">
      {% for pair in [["Tela / display", specs.screen],["Processador", specs.processor],["Memória / armazenamento", specs.memory],["Bateria / autonomia", specs.battery],["Câmeras / gráficos", specs.camera_graphics],["Sistema operacional", specs.os]] %}
        {% if pair[1] %}<div class="spec-item"><span>{{ pair[0] }}</span><strong>{{ pair[1] }}</strong></div>{% endif %}
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% if comparisons and comparisons.length %}
  <section class="comparison-section">
    <div class="section-heading">
      <div>
        <span class="eyebrow">COMPARATIVO</span>
        <h2>Compare com outras opções</h2>
        <p>Compare as principais diferenças entre o produto analisado e dois concorrentes.</p>
      </div>
    </div>

    <div class="table-wrap comparison-table-wrap" role="region" aria-label="Tabela comparativa dos três aparelhos" tabindex="0">
      <table class="comparison-table">
        <colgroup>
          <col class="comparison-label-col">
          <col class="comparison-product-col">
          <col class="comparison-product-col">
          <col class="comparison-product-col">
        </colgroup>
        <thead>
          <tr>
            <th scope="col" class="comparison-feature-heading">Característica</th>
            <th scope="col" class="comparison-product-heading">
              <div class="comparison-device">
                <div class="comparison-device-image">
                  {% if image %}
                    <img src="{{ image }}" alt="{{ image_alt or (model or title) }}" loading="lazy">
                  {% else %}
                    <span class="comparison-image-placeholder">Imagem não cadastrada</span>
                  {% endif %}
                </div>
                <span class="comparison-device-name">{{ model or title }}</span>
                <span class="comparison-device-tag">Produto analisado</span>
              </div>
            </th>
            {% for competitor in comparisons %}
            <th scope="col" class="comparison-product-heading">
              <div class="comparison-device">
                <div class="comparison-device-image">
                  {% if competitor.image %}
                    <img src="{{ competitor.image }}" alt="{{ competitor.image_alt or competitor.name }}" loading="lazy">
                  {% else %}
                    <span class="comparison-image-placeholder">Imagem não cadastrada</span>
                  {% endif %}
                </div>
                <span class="comparison-device-name">{{ competitor.name }}</span>
                <span class="comparison-device-tag">Concorrente {{ loop.index }}</span>
              </div>
            </th>
            {% endfor %}
          </tr>
        </thead>
        <tbody>
          {% set rows = [["Destaque", badge or "—", comparisons[0].highlight, comparisons[1].highlight],["Tela / display", specs.screen, comparisons[0].screen, comparisons[1].screen],["Processador", specs.processor, comparisons[0].processor, comparisons[1].processor],["Memória / armazenamento", specs.memory, comparisons[0].memory, comparisons[1].memory],["Bateria / autonomia", specs.battery, comparisons[0].battery, comparisons[1].battery],["Câmeras", specs.camera_graphics, comparisons[0].camera_graphics, comparisons[1].camera_graphics],["Preço estimado", estimated_price, comparisons[0].price, comparisons[1].price]] %}
          {% for row in rows %}
          <tr>
            <th scope="row">{{ row[0] }}</th>
            {% for cell in row.slice(1) %}
            <td>{{ cell or "—" }}</td>
            {% endfor %}
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    <div class="comparison-actions">
      {% for competitor in comparisons %}
        {% if competitor.article_slug %}<a class="button button-secondary" href="/{{ category }}/{{ competitor.article_slug }}.html">Ver análise de {{ competitor.name }} ↗</a>{% elif competitor.external_url %}<a class="button button-secondary" href="{{ competitor.external_url }}" target="_blank" rel="nofollow noopener">Ver {{ competitor.name }} ↗</a>{% endif %}
      {% endfor %}
    </div>
    <p class="comparison-note">As especificações e os preços podem variar conforme a versão e a loja. Confirme as informações antes da compra.</p>
  </section>
  {% endif %}

  <section class="article-body prose">
    {{ content | safe }}
  </section>

  {% if youtube_url %}
  <section class="video-section">
    <div class="section-heading"><div><span class="eyebrow">VÍDEO</span><h2>Assista também</h2></div></div>
    {% set video_id = youtube_url | youtubeId %}
    {% if video_id %}<div class="video-embed"><iframe src="https://www.youtube-nocookie.com/embed/{{ video_id }}" title="Vídeo do Guia Rápido Tech" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></div>
    {% else %}<p><a href="{{ youtube_url }}" rel="noopener" target="_blank">Assistir no YouTube ↗</a></p>{% endif %}
  </section>
  {% endif %}

  <footer class="review-footer"><p>Este conteúdo tem finalidade informativa. Confira as especificações e condições diretamente com o fabricante ou a loja.</p><a href="/{{ category }}/" class="text-link">← Voltar para {{ category }}</a></footer>
</article>
