---
layout: layouts/base.njk
permalink: /tablets/index.html
---
{% set categoryConfig = categories.tablets %}
<section class="category-hero container">
  <div><span class="eyebrow">CATÁLOGO DE TABLETS</span><h1>{{ categoryConfig.title }}</h1><p>{{ categoryConfig.description }}</p></div>
</section>
<section class="container category-feature-section">
  <div class="showcase-card showcase-main">
    <div class="showcase-copy"><span class="eyebrow">{{ categoryConfig.main_card.badge }}</span><h2>{{ categoryConfig.main_card.title }}</h2><p>{{ categoryConfig.main_card.description }}</p><div class="showcase-controls"><button type="button" class="slide-prev" aria-label="Slide anterior">←</button><span class="slide-status">Seleção editorial</span><button type="button" class="slide-next" aria-label="Próximo slide">→</button></div></div>
    <div class="showcase-visual"><div class="showcase-device"><span>GRT</span><b>Review</b></div></div>
    <div class="showcase-slides" data-slugs="{{ (categoryConfig.main_card.article_slugs or []) | join(',') }}" data-category="tablets"></div>
  </div>
  <div class="showcase-pair">
    {% for cardKey in ["left_card", "right_card"] %}
      {% set card = categoryConfig[cardKey] %}
      <article class="showcase-card small-showcase" data-slides="{{ (card.article_slugs or []) | join(',') }}">
        <div class="small-showcase-top"><span class="eyebrow">{{ card.badge }}</span><span class="slide-count">{{ (card.article_slugs or []) | length }} reviews</span></div>
        <h2>{{ card.title }}</h2><p>{{ card.description }}</p>
        <div class="small-slide-content" data-slugs="{{ (card.article_slugs or []) | join(',') }}" data-category="tablets"></div>
        <div class="small-showcase-controls"><button type="button" class="slide-prev" aria-label="Slide anterior">←</button><button type="button" class="slide-next" aria-label="Próximo slide">→</button></div>
      </article>
    {% endfor %}
  </div>
</section>

<section class="container catalog-section">
  <div class="section-heading section-heading-row"><div><span class="eyebrow">CATÁLOGO COMPLETO</span><h2>Encontre por marca</h2><p>Os reviews publicados entram automaticamente no catálogo.</p></div><label class="search-box"><span class="sr-only">Pesquisar produto</span><input type="search" id="catalog-search" placeholder="Pesquisar modelo..." autocomplete="off"></label></div>
  <div class="brand-filters" role="group" aria-label="Filtrar por marca">
    <button class="brand-filter is-active" data-brand="all">Todos</button>
    {% for brand in categoryConfig.brands %}<button class="brand-filter" data-brand="{{ brand | lower }}">{{ brand }}</button>{% endfor %}
    <button class="brand-filter" data-brand="other">Outros</button>
  </div>
  <div class="article-grid catalog-grid" id="catalog-grid">
    {% for article in collections.articles %}
      {% if article.data.category == "tablets" %}
        {% include "partials/article-card.njk" %}
      {% endif %}
    {% endfor %}
  </div>
  <div class="empty-state catalog-empty" hidden><span>⌕</span><h3>Nenhum review encontrado</h3><p>Tente outra marca ou termo de pesquisa.</p></div>
</section>
<script src="/assets/js/catalog.js" defer></script>
