---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>https://guiarapidotech.com.br/</loc></url>
  <url><loc>https://guiarapidotech.com.br/smartphones/</loc></url>
  <url><loc>https://guiarapidotech.com.br/tablets/</loc></url>
  <url><loc>https://guiarapidotech.com.br/notebooks/</loc></url>
  <url><loc>https://guiarapidotech.com.br/guias/</loc></url>
  <url><loc>https://guiarapidotech.com.br/sobre/</loc></url>
  <url><loc>https://guiarapidotech.com.br/privacidade/</loc></url>
  {% for article in collections.articles %}
  {% if article.url %}
  <url>
    <loc>{{ ("https://guiarapidotech.com.br" + article.url) | escape }}</loc>
    {% if article.data.updated %}
    <lastmod>{{ article.data.updated | dateISO }}</lastmod>
    {% elif article.date %}
    <lastmod>{{ article.date | dateISO }}</lastmod>
    {% endif %}
  </url>
  {% endif %}
  {% endfor %}
  {% for guide in collections.editorialGuides %}
  {% if guide.url %}
  <url>
    <loc>{{ ("https://guiarapidotech.com.br" + guide.url) | escape }}</loc>
    {% if guide.data.updated %}
    <lastmod>{{ guide.data.updated | dateISO }}</lastmod>
    {% elif guide.date %}
    <lastmod>{{ guide.date | dateISO }}</lastmod>
    {% endif %}
  </url>
  {% endif %}
  {% endfor %}

  {% for editorial in collections.freeEditorials %}
  {% if editorial.url %}
  <url>
    <loc>{{ ("https://guiarapidotech.com.br" + editorial.url) | escape }}</loc>
    {% if editorial.data.updated %}
    <lastmod>{{ editorial.data.updated | dateISO }}</lastmod>
    {% elif editorial.date %}
    <lastmod>{{ editorial.date | dateISO }}</lastmod>
    {% endif %}
  </url>
  {% endif %}
  {% endfor %}
</urlset>
